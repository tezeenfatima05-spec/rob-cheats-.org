---
interface Props {
  eyebrow: string;
  title: string;
  desc?: string;
  titleId?: string;
  centered?: boolean;
  wide?: boolean;
  /** Page-level title only — default `h2` keeps a single H1 per page (hero/article). */
  as?: 'h1' | 'h2';
}

const { eyebrow, title, desc, titleId, centered = false, wide = false, as: Tag = 'h2' } = Astro.props;
---

<header
  class:list={[
    'section-header space-y-0',
    wide && 'section-header--wide',
    centered && 'mx-auto text-center',
  ]}
>
  <p class="section-header__eyebrow">{eyebrow}</p>
  <Tag id={titleId} class="section-header__title">{title}</Tag>
  {desc ? <p class="section-header__subtitle">{desc}</p> : null}
</header>
