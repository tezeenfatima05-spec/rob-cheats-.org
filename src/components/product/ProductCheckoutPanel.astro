---
import type { ProductPage } from '../../data/products';
import Icon from '../icons/Icon.astro';
import ProductIconWell from './ProductIconWell.astro';
import { Button } from '@/components/starwind/button';

interface Props {
  product: ProductPage;
}

const { product } = Astro.props;

const checklist = product.fullFeatures.length > 0 ? product.fullFeatures : product.features;
const preview = checklist.slice(0, 12);
---

<aside
  class="product-checkout text-left lg:sticky lg:top-24"
  aria-labelledby={`checkout-${product.slug}`}
>
  <div class="overflow-hidden rounded-2xl border border-primary/35 bg-card shadow-md ring-1 ring-primary/15">
    <div class="card-title-band flex items-center justify-start gap-3 px-5 py-4 text-left">
      <ProductIconWell name="acqPackage" iconSize={20} class="bg-primary/15" />
      <div class="min-w-0 text-left">
        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Checkout</p>
        <h2 id={`checkout-${product.slug}`} class="text-base font-semibold leading-snug">
          {product.title}
        </h2>
      </div>
    </div>

    <div class="space-y-5 px-5 pb-5 pt-2">
      <p class="text-sm text-muted-foreground">{product.desc}</p>

      <div class="space-y-2">
        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Feature checklist</p>
        <ul class="max-h-64 space-y-2 overflow-y-auto pr-1">
          {
            preview.map((feature) => (
              <li class="flex items-start gap-2 text-sm text-muted-foreground">
                <Icon name="check" size={15} class="product-feature-check mt-0.5 shrink-0 icon-app--primary" />
                <span>{feature}</span>
              </li>
            ))
          }
        </ul>
        {
          checklist.length > preview.length && (
            <p class="text-xs text-muted-foreground">+{checklist.length - preview.length} more in the portal</p>
          )
        }
      </div>

      <Button as="a" href={product.buyUrl} variant="primary" size="lg" class="w-full rounded-xl">
        Buy now
        <Icon name="arrowRight" size={17} />
      </Button>
    </div>
  </div>
</aside>
